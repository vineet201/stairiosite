                  </div>
                </GlowingBorder>
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* ==================== VALUE PROPOSITION SECTION ==================== */}
      <section ref={valueRef} className="relative py-24 sm:py-36 overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-b from-transparent via-[#5DDF18]/[0.02] to-transparent" />
        
        <div className="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
          <motion.div initial={{ opacity: 0, y: 50 }} animate={isValueInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8 }}>
            <h2 className="text-4xl sm:text-5xl md:text-6xl font-bold mb-10 leading-tight">
              <span className="text-white">This is not just a website. </span>
              <br className="hidden sm:block" />
              <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#5DDF18] via-[#D8B4FE] to-[#FF9132]">It&apos;s your digital salesman.</span>
            </h2>
          </motion.div>

          <motion.p initial={{ opacity: 0, y: 40 }} animate={isValueInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8, delay: 0.2 }} className="text-xl text-neutral-400 mb-16">
            Your website should work for you 24/7:
          </motion.p>

          <motion.div initial={{ opacity: 0, y: 40 }} animate={isValueInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8, delay: 0.3 }} className="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
            {[
              { icon: Users, text: "Bringing new enquiries", color: "#D8B4FE" },
              { icon: Shield, text: "Building trust instantly", color: "#FF9132" },
              { icon: Zap, text: "Converting visitors into paying customers", color: "#5DDF18" }
            ].map((item, index) => (
              <motion.div key={index} whileHover={{ y: -8, scale: 1.02 }} transition={{ duration: 0.3 }} className="relative group">
                <div className="absolute -inset-1 rounded-3xl bg-gradient-to-r opacity-0 group-hover:opacity-50 blur-xl transition-opacity duration-500" style={{ background: `linear-gradient(135deg, ${item.color}50, transparent)` }} />
                <div className="relative p-8 rounded-3xl bg-white/[0.02] border border-white/[0.06] hover:border-white/[0.15] transition-all duration-300 backdrop-blur-sm">
                  <div className="relative w-14 h-14 mx-auto mb-6 rounded-2xl flex items-center justify-center" style={{ background: `linear-gradient(135deg, ${item.color}20, transparent)` }}>
                    <item.icon className="w-7 h-7" style={{ color: item.color }} />
                  </div>
                  <p className="text-neutral-200 text-lg font-medium">{item.text}</p>
                </div>
              </motion.div>
            ))}
          </motion.div>

          <motion.p initial={{ opacity: 0, y: 40 }} animate={isValueInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8, delay: 0.4 }} className="text-xl text-neutral-300 italic font-light">
            We build systems that help your business grow — <span className="text-[#5DDF18] font-medium not-italic">even when you&apos;re offline.</span>
          </motion.p>
        </div>
      </section>

      {/* ==================== INTERACTIVE DEMO SECTION ==================== */}
      <section ref={demoRef} className="relative py-24 sm:py-36">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-16">
            <motion.h2 initial={{ opacity: 0, y: 30 }} animate={isDemoInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
              <span className="text-white">See how your website </span>
              <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#D8B4FE]">comes to life</span>
            </motion.h2>
            <motion.p initial={{ opacity: 0, y: 30 }} animate={isDemoInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6, delay: 0.1 }} className="text-xl text-neutral-400">
              From idea to live website — experience how Stairio simplifies everything.
            </motion.p>
          </div>

          <motion.div initial={{ opacity: 0, y: 40 }} animate={isDemoInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8, delay: 0.2 }} className="relative">
            <div className="absolute -inset-2 bg-gradient-to-r from-[#D8B4FE]/10 via-[#FF9132]/10 to-[#5DDF18]/10 rounded-[40px] blur-2xl" />
            
            <div className="relative rounded-[32px] bg-gradient-to-b from-white/[0.05] to-white/[0.01] border border-white/[0.08] overflow-hidden backdrop-blur-xl">
              <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#D8B4FE]/60 to-transparent" />
              
              <div className="flex border-b border-white/[0.06] relative">
                <motion.div layoutId="activeTab" className="absolute bottom-0 h-0.5 bg-gradient-to-r from-[#D8B4FE] to-[#FF9132]" style={{ left: `${demoTabs.findIndex(t => t.id === activeTab) * 33.33}%`, width: "33.33%" }} transition={{ type: "spring", stiffness: 300, damping: 30 }} />
                
                {demoTabs.map((tab) => (
                  <button key={tab.id} onClick={() => setActiveTab(tab.id)} className={`flex-1 py-5 px-6 text-sm font-medium capitalize transition-all relative ${activeTab === tab.id ? "text-white" : "text-neutral-500 hover:text-neutral-300"}`}>
                    {activeTab === tab.id && <motion.div layoutId="tabBg" className="absolute inset-0 bg-white/[0.03]" transition={{ type: "spring", stiffness: 300, damping: 30 }} />}
                    <span className="relative z-10">{tab.id}</span>
                  </button>
                ))}
              </div>

              <div className="p-10 sm:p-14 min-h-[450px]">
                <AnimatePresence mode="wait">
                  {demoTabs.map((tab) => (
                    activeTab === tab.id && (
                      <motion.div key={tab.id} initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.4 }} className="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
                        <div>
                          <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6" style={{ background: `${tab.color}15`, border: `1px solid ${tab.color}30` }}>
                            <tab.icon className="w-4 h-4" style={{ color: tab.color }} />
                            <span className="text-sm font-medium" style={{ color: tab.color }}>{tab.id.charAt(0).toUpperCase() + tab.id.slice(1)}</span>
                          </div>
                          
                          <h3 className="text-3xl sm:text-4xl font-bold text-white mb-6">{tab.title}</h3>
                          <p className="text-lg text-neutral-400 mb-8 leading-relaxed">{tab.description}</p>
                          <ul className="space-y-4">
                            {tab.features.map((item, i) => (
                              <motion.li key={i} initial={{ opacity: 0, x: -20 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: i * 0.1 }} className="flex items-center gap-4 text-neutral-200">
                                <div className="w-6 h-6 rounded-full flex items-center justify-center" style={{ background: `${tab.color}20` }}>
                                  <Check className="w-4 h-4" style={{ color: tab.color }} />
                                </div>
                                {item}
                              </motion.li>
                            ))}
                          </ul>
                        </div>
                        
                        <div className="relative">
                          <div className="absolute -inset-4 rounded-3xl blur-2xl" style={{ background: `${tab.color}15` }} />
                          <div className="relative aspect-[4/3] rounded-2xl bg-gradient-to-br from-neutral-800/80 to-neutral-900/80 border border-white/[0.08] flex items-center justify-center overflow-hidden">
                            <div className="absolute top-0 inset-x-0 h-10 bg-neutral-900/80 border-b border-white/[0.06] flex items-center px-4 gap-2">
                              <div className="w-3 h-3 rounded-full bg-red-500/60" />
                              <div className="w-3 h-3 rounded-full bg-yellow-500/60" />
                              <div className="w-3 h-3 rounded-full bg-green-500/60" />
                              <div className="flex-1 mx-4">
                                <div className="h-6 rounded-md bg-white/[0.05] flex items-center px-3">
                                  <Globe className="w-3 h-3 text-neutral-500 mr-2" />
                                  <span className="text-xs text-neutral-500">stairio.com</span>
                                </div>
                              </div>
                            </div>
                            
                            <div className="pt-10 flex items-center justify-center w-full h-full">
                              <motion.div animate={{ scale: [1, 1.1, 1], rotate: [0, 5, 0, -5, 0] }} transition={{ duration: 4, repeat: Infinity }}>
                                <tab.icon className="w-20 h-20" style={{ color: `${tab.color}40` }} />
                              </motion.div>
                            </div>
                          </div>
                        </div>
                      </motion.div>
                    )
                  ))}
                </AnimatePresence>
              </div>
            </div>
          </motion.div>
        </div>
      </section>

      {/* ==================== PRICING SECTION ==================== */}
      <section ref={pricingRef} className="relative py-24 sm:py-36">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-20">
            <motion.h2 initial={{ opacity: 0, y: 30 }} animate={isPricingInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
              <span className="text-white">Choose a plan that </span>
              <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#D8B4FE]">fits your business</span>
            </motion.h2>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
            {pricingPlans.map((plan, index) => (
              <motion.div key={index} initial={{ opacity: 0, y: 40 }} animate={isPricingInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6, delay: index * 0.1 }} onMouseEnter={() => setHoveredPlan(index)} onMouseLeave={() => setHoveredPlan(null)} className="relative">
                {plan.popular && <div className="absolute -inset-4 bg-gradient-to-r from-[#D8B4FE]/30 via-[#FF9132]/20 to-[#D8B4FE]/30 rounded-[40px] blur-2xl animate-pulse" />}
                
                <div className={`relative h-full p-8 sm:p-10 rounded-3xl transition-all duration-500 ${plan.popular ? "bg-gradient-to-b from-white/[0.08] to-white/[0.02] border-2 border-[#D8B4FE]/50" : "bg-gradient-to-b from-white/[0.03] to-transparent border border-white/[0.06] hover:border-white/[0.12]"}`}>
                  {plan.popular && (
                    <div className="absolute -top-4 left-1/2 -translate-x-1/2">
                      <div className="relative">
                        <div className="absolute inset-0 bg-gradient-to-r from-[#D8B4FE] to-[#FF9132] rounded-full blur-md" />
                        <div className="relative px-6 py-2 rounded-full bg-gradient-to-r from-[#D8B4FE] to-[#FF9132] text-sm font-bold text-white flex items-center gap-2">
                          <Star className="w-4 h-4" fill="currentColor" />
                          Recommended
                        </div>
                      </div>
                    </div>
                  )}
                  
                  <div className="pt-4">
                    <h3 className="text-2xl font-bold text-white mb-2">{plan.name}</h3>
                    <p className="text-neutral-400 mb-8">{plan.tagline}</p>
                    
                    <ul className="space-y-4 mb-10">
                      {plan.features.map((item, i) => (
                        <li key={i} className="flex items-center gap-3 text-neutral-300">
                          <div className="w-5 h-5 rounded-full bg-[#5DDF18]/20 flex items-center justify-center flex-shrink-0">
                            <Check className="w-3 h-3 text-[#5DDF18]" />
                          </div>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    
                    {plan.popular ? (
                      <div className="relative">
                        <div className="absolute -inset-1 bg-gradient-to-r from-[#D8B4FE] to-[#FF9132] rounded-full opacity-50 blur-md" />
                        <LiquidMetalButton label={plan.cta} />
                      </div>
                    ) : (
                      <button className="w-full py-4 rounded-full border border-white/[0.1] text-white hover:bg-white/[0.05] hover:border-white/[0.2] transition-all duration-300 font-medium">{plan.cta}</button>
                    )}
                  </div>
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* ==================== STATS SECTION ==================== */}
      <section ref={statsRef} className="relative py-20">
        <div className="absolute inset-0 bg-gradient-to-r from-[#D8B4FE]/[0.03] via-[#FF9132]/[0.03] to-[#5DDF18]/[0.03]" />
        <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.1] to-transparent" />
        <div className="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.1] to-transparent" />
        
        <div className="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
          <motion.div initial={{ opacity: 0, y: 30 }} animate={isStatsInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="grid grid-cols-1 sm:grid-cols-3 gap-12 text-center">
            {[
              { value: "10000", suffix: "+", label: "websites built" },
              { value: "99.9", suffix: "%", label: "uptime" },
              { value: "24/7", suffix: "", label: "support" }
            ].map((stat, index) => (
              <div key={index} className="relative group">
                <div className="absolute -inset-4 rounded-3xl bg-gradient-to-r from-[#D8B4FE]/10 to-[#FF9132]/10 opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500" />
                <div className="relative">
                  <div className="text-5xl sm:text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#D8B4FE] mb-3">
                    {stat.suffix === "%" || stat.value === "24/7" ? stat.value + stat.suffix : <AnimatedCounter value={stat.value} suffix={stat.suffix} />}
                  </div>
                  <div className="text-lg text-neutral-400">{stat.label}</div>
                </div>
              </div>
            ))}
          </motion.div>
        </div>
      </section>

      {/* ==================== PROCESS SECTION ==================== */}
      <section ref={processRef} className="relative py-24 sm:py-36">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-20">
            <motion.h2 initial={{ opacity: 0, y: 30 }} animate={isProcessInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
              <span className="text-white">Simple. Clear. </span>
              <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#5DDF18] via-[#D8B4FE] to-[#FF9132]">Hassle-free.</span>
            </motion.h2>
            <motion.p initial={{ opacity: 0, y: 30 }} animate={isProcessInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6, delay: 0.1 }} className="text-xl text-neutral-400">
              No confusion. No technical headache.
            </motion.p>
          </div>

          <div className="relative">
            <div className="hidden md:block absolute top-1/2 left-0 right-0 h-1 -translate-y-1/2">
              <div className="absolute inset-0 bg-gradient-to-r from-[#D8B4FE]/30 via-[#FF9132]/30 to-[#5DDF18]/30 rounded-full" />
              <motion.div initial={{ scaleX: 0 }} animate={isProcessInView ? { scaleX: 1 } : {}} transition={{ duration: 1.5, delay: 0.5, ease: "easeOut" }} className="absolute inset-0 bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#5DDF18] rounded-full origin-left" />
            </div>
            
            <div className="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6">
              {processSteps.map((step, index) => (
                <motion.div key={index} initial={{ opacity: 0, y: 40 }} animate={isProcessInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6, delay: 0.2 + index * 0.15 }} className="relative text-center group">
                  <div className="relative z-10 mb-8 inline-block">
                    <div className="absolute -inset-4 rounded-full bg-gradient-to-r from-[#D8B4FE]/30 to-[#FF9132]/30 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                    <div className="relative w-20 h-20 rounded-full bg-gradient-to-br from-[#D8B4FE] via-[#FF9132] to-[#5DDF18] p-[2px] group-hover:scale-110 transition-transform duration-300">
                      <div className="w-full h-full rounded-full bg-[#0a0a0a] flex items-center justify-center">
                        <step.icon className="w-8 h-8 text-white" />
                      </div>
                    </div>
                    <div className="absolute -bottom-2 -right-2 w-8 h-8 rounded-full bg-gradient-to-r from-[#D8B4FE] to-[#FF9132] flex items-center justify-center text-sm font-bold text-white shadow-lg">{index + 1}</div>
                  </div>
                  
                  <h3 className="text-xl font-bold text-white mb-2">{step.title}</h3>
                  <p className="text-neutral-400">{step.description}</p>
                </motion.div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ==================== HIGHLIGHTS SECTION ==================== */}
      <section ref={highlightsRef} className="relative py-20 bg-gradient-to-b from-transparent via-white/[0.01] to-transparent">
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <motion.div initial={{ opacity: 0, y: 30 }} animate={isHighlightsInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6">
            {highlights.map((item, index) => (
              <motion.div key={index} initial={{ opacity: 0, y: 20 }} animate={isHighlightsInView ? { opacity: 1, y: 0 } : {}} transition={{ delay: index * 0.1 }} whileHover={{ y: -5 }} className="flex flex-col items-center text-center p-6 rounded-2xl bg-white/[0.02] border border-white/[0.04] hover:border-white/[0.1] transition-all duration-300 group">
                <div className="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 transition-all duration-300" style={{ background: `${item.color}15` }}>
                  <item.icon className="w-7 h-7 transition-transform duration-300 group-hover:scale-110" style={{ color: item.color }} />
                </div>
                <p className="text-sm text-neutral-400 group-hover:text-neutral-300 transition-colors">{item.text}</p>
              </motion.div>
            ))}
          </motion.div>
        </div>
      </section>

      {/* ==================== FAQ SECTION ==================== */}
      <section ref={faqRef} className="relative py-24 sm:py-36">
        <div className="max-w-3xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-16">
            <motion.h2 initial={{ opacity: 0, y: 30 }} animate={isFaqInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6 }} className="text-4xl sm:text-5xl font-bold mb-6">
              <span className="text-white">Frequently Asked </span>
              <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#D8B4FE]">Questions</span>
            </motion.h2>
          </div>

          <motion.div initial={{ opacity: 0, y: 40 }} animate={isFaqInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.6, delay: 0.2 }} className="space-y-4">
            {faqs.map((faq, index) => (
              <FAQItem key={index} index={index} question={faq.question} answer={faq.answer} isOpen={openFaq === index} onClick={() => setOpenFaq(openFaq === index ? null : index)} />
            ))}
          </motion.div>
        </div>
      </section>

      {/* ==================== FINAL CTA SECTION ==================== */}
      <section ref={ctaRef} className="relative py-24 sm:py-36">
        <div className="max-w-5xl mx-auto px-4 sm:px-6">
          <motion.div initial={{ opacity: 0, y: 50 }} animate={isCtaInView ? { opacity: 1, y: 0 } : {}} transition={{ duration: 0.8 }} className="relative">
            <div className="absolute -inset-10 bg-gradient-to-r from-[#D8B4FE]/20 via-[#FF9132]/15 to-[#5DDF18]/10 rounded-[60px] blur-3xl" />
            
            <div className="relative text-center p-12 sm:p-20 rounded-[40px] overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-[#D8B4FE]/15 via-[#FF9132]/10 to-[#5DDF18]/10 animate-gradient bg-[length:200%_200%]" />
              <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
              <div className="absolute inset-0 rounded-[40px] border border-white/[0.1]" />
              <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#D8B4FE]/60 to-transparent" />
              
              {[...Array(6)].map((_, i) => (
                <motion.div key={i} animate={{ y: [-20, 20, -20], opacity: [0.3, 0.6, 0.3] }} transition={{ duration: 4 + i, repeat: Infinity, delay: i * 0.5 }} className="absolute w-2 h-2 rounded-full" style={{ left: `${15 + i * 15}%`, top: `${20 + (i % 3) * 20}%`, background: ["#D8B4FE", "#FF9132", "#5DDF18"][i % 3] }} />
              ))}
              
              <div className="relative z-10">
                <h2 className="text-4xl sm:text-5xl md:text-6xl font-bold mb-8 leading-tight">
                  <span className="text-white">Don&apos;t let your competitors </span>
                  <br className="hidden sm:block" />
                  <span className="bg-clip-text text-transparent bg-gradient-to-r from-[#FF9132] via-[#D8B4FE] to-[#FF9132]">take your customers.</span>
                </h2>
                
                <p className="text-xl text-neutral-300 mb-12 max-w-2xl mx-auto leading-relaxed">
                  Every day you delay, you are losing business to someone who is already online.
                </p>
                
                <div className="relative inline-block">
                  <div className="absolute -inset-2 bg-gradient-to-r from-[#D8B4FE] via-[#FF9132] to-[#5DDF18] rounded-full opacity-50 blur-xl animate-pulse" />
                  <LiquidMetalButton label="Start Building Your Website" />
                </div>
                
                <p className="mt-8 text-neutral-500 text-sm">No credit card required • Free consultation</p>
              </div>
            </div>
          </motion.div>
        </div>
      </section>
    </main>
  );
}
